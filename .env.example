# 应用配置
NEXT_PUBLIC_APP_NAME="Game Admin"
NEXT_PUBLIC_APP_DESCRIPTION="后台管理系统"
# 站点自身公网地址（用于 OAuth 回调 / canonical URL）
NEXT_PUBLIC_SITE_URL=https://admin.jade.ai

# ── 后端地址（BFF 转发目标）──────────────────────────
# admin 的 /api/* Route Handlers 作为 BFF 代理到后端 admin-api（Go 服务）。
# ADMIN_API_URL 为统一后端基址；个别路由仍读 REMOTE_API_URL 做精细化覆盖。
# ⚠️ 注意：部分路由当前把目标地址硬编码为上游模板（xreddeercasino.com），
#    迁移到本项目时需逐步替换为下方环境变量。部署到 Vercel 前请确认。
ADMIN_API_URL=https://admin-api.jade.ai
REMOTE_API_URL=https://admin-api.jade.ai

# JWT 配置
JWT_SECRET=your_very_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 管理员配置
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=Administrator
ADMIN_PASSWORD=Admin@123456
SUPER_ADMIN_EMAILS=admin@example.com
SALT_ROUNDS=12
