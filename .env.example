# 应用配置
NEXT_PUBLIC_APP_NAME="Game Admin"
NEXT_PUBLIC_APP_DESCRIPTION="后台管理系统"

# JWT 配置
JWT_SECRET=your_very_long_random_secret_key

# 管理员配置
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=Administrator
ADMIN_PASSWORD=Admin@123456
SALT_ROUNDS=12

# 频道关键词自动回复：机器人调用 /api/bot/channel-reply-rules/match 时校验（可选；不配置则不调校验，仅建议本地）
# CHANNEL_REPLY_RULES_BOT_SECRET=随机长字符串

# Cloudflare R2（存储管理 / 列表与预签名上传下载，服务端读取）
# 在 Cloudflare 控制台：R2 → 某一存储桶 →「设置」→ S3 API，可查看 Account ID 并创建 API 令牌（Access Key / Secret）
# 二选一配置 endpoint：
# - 推荐：只填账号 ID，代码会拼成 https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCOUNT_ID=be990c34226472945c4400b4afec9031
# - 或：直接写完整 S3 兼容 endpoint（若你使用自定义域名等）
# CLOUDFLARE_R2_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=你的_R2_API_访问密钥_ID
CLOUDFLARE_R2_SECRET_ACCESS_KEY=你的_R2_API_密钥
# 可选，默认 auto
# CLOUDFLARE_R2_REGION=auto
# 预签名 URL 有效期（秒），默认 900
# CLOUDFLARE_R2_PRESIGN_EXPIRES=900
#
# 按 bucket 使用不同 Cloudflare 账号/密钥：在 storage-buckets 里给对应项加 r2Profile（大写英文，如 PIGBA）
# 则会优先读取下列变量，缺省项再回退到上面的全局 CLOUDFLARE_R2_*：
# CLOUDFLARE_R2_PIGBA_ACCOUNT_ID=
# CLOUDFLARE_R2_PIGBA_ENDPOINT=
# CLOUDFLARE_R2_PIGBA_ACCESS_KEY_ID=
# CLOUDFLARE_R2_PIGBA_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_PIGBA_REGION=
# CLOUDFLARE_R2_PIGBA_PRESIGN_EXPIRES=
